---
layout: null
---
[
{% for post in site.posts %}
{
  "title": {{ post.title | jsonify }},
  "url": {{ post.url | relative_url | jsonify }},
  "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
  "category": {{ post.categories | first | default: "笔记" | jsonify }},
  "tags": {{ post.tags | jsonify }},
  "description": {{ post.description | default: post.summary | strip_html | strip_newlines | truncate: 140 | jsonify }},
  "content": {{ post.content | strip_html | strip_newlines | replace: "  ", " " | truncate: 4000 | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
