---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }} · {{ site.subtitle }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/' | absolute_url }}</id>
  <author>
    <name>{{ site.owner.name }}</name>
    <uri>{{ '/' | absolute_url }}</uri>
  </author>
  <generator>Jekyll</generator>
  {% for post in site.posts limit: 20 %}
  <entry>
    <title type="html">{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <summary type="html">{{ post.description | default: post.summary | xml_escape }}</summary>
    <content type="html">{{ post.content | xml_escape }}</content>
    <author><name>{{ site.owner.name }}</name></author>
    {% for tag in post.tags %}<category term="{{ tag | xml_escape }}"/>
    {% endfor %}
  </entry>
  {% endfor %}
</feed>
