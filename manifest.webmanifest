layout: null
---
{
  "name": "{{ site.title }} · {{ site.subtitle }}",
  "short_name": "{{ site.title }}",
  "description": "{{ site.description }}",
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#edf5f5",
  "theme_color": "#2f5871",
  "lang": "zh-CN",
  "icons": [
    {
      "src": "{{ '/assets/img/avatar.svg' | relative_url }}",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
